{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synthea Simulation",
  "version": "2.0.0",
  "identifier": "org.syntheasimulation.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Synthea Simulation",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/synthea-backend"],
    "category": "Education",
    "shortDescription": "Scientific food engineering workstation",
    "longDescription": "Synthea Simulation: scientific material libraries, research-paper extraction, model registry, geometry, digital twins and virtual experiments for food formulation.",
    "copyright": "Synthea Simulation team",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {}
}
